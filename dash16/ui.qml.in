import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.3
import QtQuick.Controls.Material 2.2
import Vedder.vesc.utility 1.0

import Vedder.vesc.commands 1.0
import Vedder.vesc.configparams 1.0

Item {
    id: mainItem
    anchors.fill: parent
    anchors.margins: 5

    property Commands mCommands: VescIf.commands()

    // Colors of the refreshed VESC Tool, or the closest older ones where the running VESC Tool does
    // not have them, as it gives red for names it does not know
    function themeColor(name, fallback) {
        var c = Utility.getAppHexColor(name)
        return c === "#ff0000" ? Utility.getAppHexColor(fallback) : c
    }

    readonly property color colCard: themeColor("cardBackground", "normalBackground")
    readonly property color colBorder: themeColor("raisedBackground", "lightBackground")
    readonly property color colText: themeColor("titleText", "lightText")
    readonly property color colLabel: Utility.getAppHexColor("normalText")

    // The parts below look like the VESC Tool settings pages. They are defined here rather than taken
    // from VESC Tool, as the versions before its refreshed UI do not have them.

    // Title above a group of settings
    component SectionTitle: RowLayout {
        property alias text: label.text

        Layout.fillWidth: true
        Layout.topMargin: 10
        spacing: 10

        Text {
            id: label
            color: Utility.getAppHexColor("lightAccent")
            font.family: "Exan"
            font.letterSpacing: 1.5
            font.capitalization: Font.AllUppercase
        }

        Rectangle {
            Layout.fillWidth: true
            height: 1
            color: Utility.getAppHexColor("lightAccent")
            opacity: 0.3
        }
    }

    // Settings drawn as one card, with a line between them
    component Group: Rectangle {
        default property alias rows: rowColumn.data

        Layout.fillWidth: true
        implicitHeight: rowColumn.implicitHeight
        radius: 12
        color: colCard
        border.color: colBorder

        ColumnLayout {
            id: rowColumn
            width: parent.width
            spacing: 0
        }
    }

    // A setting in a Group, with its name on the left and its value, or a control such as a switch, on
    // the right. Tapping it opens its editor below it.
    component SettingRow: Item {
        id: row

        property string label: ""
        property string value: ""
        property Item control: null
        property bool chevron: false
        property bool expanded: false
        default property alias editor: editorColumn.data
        readonly property bool editable: editorColumn.children.length > 0

        Layout.fillWidth: true
        implicitHeight: header.height + (expanded ? editorColumn.implicitHeight + 12 : 0)
        clip: true

        Behavior on implicitHeight {
            NumberAnimation { duration: 200; easing.type: Easing.OutCubic }
        }

        onControlChanged: {
            if (control) {
                control.parent = holder
            }
        }

        // One open at a time
        onExpandedChanged: {
            if (expanded && parent) {
                for (var i = 0; i < parent.children.length; i++) {
                    var r = parent.children[i]
                    if (r !== row && r.editable !== undefined && r.expanded) {
                        r.expanded = false
                    }
                }
            }
        }

        Rectangle {
            width: parent.width
            height: 1
            visible: row.y > 0
            color: colBorder
        }

        Item {
            id: header
            width: parent.width
            height: Math.max(52, headerRow.implicitHeight + 12)

            MouseArea {
                anchors.fill: parent
                enabled: row.editable
                onClicked: row.expanded = !row.expanded
            }

            RowLayout {
                id: headerRow
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.leftMargin: 14
                anchors.rightMargin: 12
                anchors.verticalCenter: parent.verticalCenter
                spacing: 10

                Text {
                    Layout.fillWidth: true
                    text: row.label
                    wrapMode: Text.Wrap
                    color: colText
                    font.weight: row.expanded ? Font.Medium : Font.Normal
                }

                Text {
                    Layout.maximumWidth: row.width * 0.45
                    visible: row.control === null && text !== ""
                    text: row.value
                    elide: Text.ElideRight
                    color: colText
                    font.weight: Font.Medium
                }

                Item {
                    id: holder
                    implicitWidth: row.control ? row.control.implicitWidth : 0
                    implicitHeight: row.control ? row.control.implicitHeight : 0
                    visible: row.control !== null
                }

                Text {
                    visible: row.chevron
                    text: "›"
                    rotation: row.expanded ? 90 : 0
                    font.pointSize: 18
                    color: Utility.getAppHexColor("disabledText")
                }
            }
        }

        ColumnLayout {
            id: editorColumn
            x: 14
            y: header.height
            width: parent.width - 26
            visible: row.expanded || row.height > header.height + 1
        }
    }

    // Background that styles ComboBox, SpinBox and TextField like the cards
    component InputBackground: Rectangle {
        implicitWidth: parent instanceof SpinBox ? 140 : 120
        implicitHeight: 48
        radius: 12
        color: colCard
        border.color: parent.activeFocus ? Material.accent : colBorder
    }

    // Help text under a group
    component Note: Text {
        Layout.fillWidth: true
        Layout.leftMargin: 4
        Layout.rightMargin: 4
        wrapMode: Text.WordWrap
        color: colLabel
        font.pointSize: 10
    }

    // Section switcher: tap only, like the chips on the VESC Tool settings pages. It wraps instead of scrolling
    // sideways, so that a sideways swipe always reaches the VESC Tool pages around the package.
    component SectionChips: Flow {
        id: chips

        property var model: []
        property int currentIndex: 0
        // dots[i] === true shows a dot on chip i
        property var dots: []

        signal chosen(int index)

        Layout.fillWidth: true
        spacing: 6

        Repeater {
            model: chips.model

            AbstractButton {
                id: chip

                readonly property bool on: index === chips.currentIndex

                text: modelData
                focusPolicy: Qt.NoFocus
                // 44 pt touch target around the 32 pt pill
                topInset: 6
                bottomInset: 6
                leftPadding: 12
                rightPadding: 12
                implicitHeight: 44
                implicitWidth: contentItem.implicitWidth + leftPadding + rightPadding
                Accessible.role: Accessible.PageTab
                Accessible.name: text
                onClicked: chips.chosen(index)

                contentItem: Item {
                    implicitWidth: chipRow.implicitWidth
                    implicitHeight: chipRow.implicitHeight

                    Row {
                        id: chipRow
                        anchors.centerIn: parent
                        spacing: 6

                        Text {
                            id: chipLabel
                            anchors.verticalCenter: parent.verticalCenter
                            // As wide as the selected label, so that selecting does not move the chips after it
                            width: Math.ceil(Math.max(implicitWidth, selectedMetrics.advanceWidth))
                            horizontalAlignment: Text.AlignHCenter
                            text: chip.text
                            color: chip.on ? colText : colLabel
                            font.weight: chip.on ? Font.Medium : Font.Normal

                            TextMetrics {
                                id: selectedMetrics
                                font.family: chipLabel.font.family
                                font.pointSize: chipLabel.font.pointSize
                                font.weight: Font.Medium
                                text: chip.text
                            }
                        }

                        Rectangle {
                            anchors.verticalCenter: parent.verticalCenter
                            width: 6
                            height: 6
                            radius: 3
                            visible: chips.dots[index] === true
                            color: Material.accent
                        }
                    }
                }

                background: Rectangle {
                    radius: height / 2
                    color: chip.on ? Qt.rgba(Material.accent.r, Material.accent.g, Material.accent.b, 0.12) : colCard
                    border.width: chip.on ? 1.5 : 1
                    border.color: chip.on ? Material.accent : colBorder
                }
            }
        }
    }

    property ConfigParams mMcConf: VescIf.mcConfig()

    property bool loading: false

    property var slotNames: [
        "Speed", "Battery %", "Motor amps", "Battery amps", "Power",
        "Voltage", "Motor temp", "ESC temp", "Pack temp", "Duty",
        "Trip", "Odometer", "Energy used", "Regen", "Amp hours",
        "Peak amps", "Top speed", "Pitch"
    ]

    // Action codes are shared across the dashes, so a button set to "Lights"
    // means the same thing everywhere. This display has no settings page and
    // no backlight level, so codes 3 and 7 are simply absent here and the
    // dropdown index is mapped through actionCodes rather than used directly.
    property var actionNames: [
        "Nothing", "Next page", "Previous page",
        "Drive mode up", "Drive mode down", "Lights", "Cruise control",
        "Toggle logging", "Reverse (at a stop)"
    ]
    property var actionCodes: [0, 1, 2, 4, 5, 6, 8, 9, 10]

    function actionIndex(code) {
        var ix = actionCodes.indexOf(code)
        return ix < 0 ? 0 : ix
    }

    property bool haveRead: false

    // One section on screen at a time. Scrolling past everything to reach one
    // setting is the thing this avoids.
    property int editing: 0

    property real leverVolts: 0.0
    property real leverPos: 0.0

    property var iconNames: [
        "Turn signals", "High and low beam", "Fault warning", "Cruise control"
    ]
    // Mask bit for each entry above. Kickstand and temperature are not drawn
    // on this panel, so they are not offered.
    property var iconBits: [0, 1, 4, 5]
    property int iconMask: 0x3F

    property var pageNames: ["Live", "Trip", "Battery"]
    property int pageMask: 0x7

    // Custom app data, not the REPL: the firmware silently drops REPL
    // commands sent within 0.5 s of each other. This path is quicker but not
    // instant either, so commands are queued and paced rather than fired off
    // as fast as the user can click.
    property var sendQueue: []
    property bool sendBusy: false

    Timer {
        id: sendTimer
        interval: 350
        repeat: false
        onTriggered: sendPump()
    }

    function sendPump() {
        if (sendQueue.length === 0) {
            sendBusy = false
            return
        }
        var q = sendQueue
        var cmd = q.shift()
        sendQueue = q
        VescIf.commands().sendCustomAppData(cmd + "\0")
        sendBusy = true
        sendTimer.restart()
    }

    function send(cmd) {
        var q = sendQueue
        q.push(cmd)
        sendQueue = q
        if (!sendBusy) {
            sendPump()
        }
    }

    function setSetting(name, value) {
        send("(settings-set '" + name + " " + value + ")")
    }

    ButtonGroup { id: speedGroup }
    ButtonGroup { id: tempGroup }

    // The read-back sits in a Loader activated once the page has drawn. If
    // onLispPrintReceived is missing in the running VESC Tool only the loader
    // fails; at the root an unknown signal takes the whole page down.
    // Keeps asking until the display answers, so the page never shows its
    // own defaults as if they were real values.
    Timer {
        id: readPoll
        interval: 700
        running: true
        repeat: true
        onTriggered: {
            if (haveRead) { running = false } else { send("(send-cfg)") }
        }
    }

    // Reading the lever, so drops do not matter and it skips the send queue
    Timer {
        interval: 300
        running: editing === 3
        repeat: true
        onTriggered: VescIf.commands().sendCustomAppData("(send-lever)\0")
    }

    Connections {
        target: VescIf.commands()

        function onCustomAppDataReceived(data) {
            var str = data.toString()
            if (str.startsWith("lever ")) {
                var lv = str.trim().split(" ")
                leverVolts = parseFloat(lv[1])
                leverPos = parseFloat(lv[2])
                return
            }
            if (!str.startsWith("cfg ")) { return }
            var v = str.trim().split(" ")
            if (v.length < 22) { return }

            loading = true
            speedMetric.checked = parseInt(v[1]) === 1
            speedImperial.checked = parseInt(v[1]) !== 1
            tempMetric.checked = parseInt(v[2]) === 1
            tempImperial.checked = parseInt(v[2]) !== 1
            driveModes.value = parseInt(v[3])
            escMode.currentIndex = parseInt(v[4])
            escId.value = parseInt(v[5])
            var live = parseInt(v[6]) === 1
            var seenId = parseInt(v[7])
            escState.text = (live
                ? "Running standalone, controller " +
                  (seenId < 0 ? "not found" : seenId)
                : "dash_esc detected")

            for (var b = 0; b < 2; b++) {
                btnRepeater.itemAt(b).shortIndex = actionIndex(parseInt(v[8 + b]))
                btnRepeater.itemAt(b).longIndex = actionIndex(parseInt(v[10 + b]))
            }
            for (var sl = 0; sl < 4; sl++) {
                slotRepeater.itemAt(sl).source = parseInt(v[12 + sl])
            }

            iconMask = parseInt(v[16])
            for (var ic = 0; ic < iconRepeater.count; ic++) {
                iconRepeater.itemAt(ic).checked =
                    (iconMask & (1 << iconBits[ic])) !== 0
            }

            pageMask = parseInt(v[17])
            for (var pg = 0; pg < pageRepeater.count; pg++) {
                pageRepeater.itemAt(pg).checked = (pageMask & (1 << pg)) !== 0
            }
            blSlider.value = parseFloat(v[18])
            battRampBox.checked = parseInt(v[19]) === 1
            leverMin.realValue = parseFloat(v[20])
            leverMax.realValue = parseFloat(v[21])
            splashBox.checked = parseInt(v[22]) === 1

            loading = false
            haveRead = true
            statusText.text = "Read from display"
        }
    }

    function setIconBit(bit, on) {
        if (on) { iconMask |= (1 << bit) } else { iconMask &= ~(1 << bit) }
        setSetting("icon-mask", iconMask)
    }

    function setPageBit(bit, on) {
        if (on) { pageMask |= (1 << bit) } else { pageMask &= ~(1 << bit) }
        setSetting("page-mask", pageMask)
    }

    ColumnLayout {
        anchors.fill: parent
        spacing: 10

        Text {
            Layout.fillWidth: true
            color: colText
            font.pointSize: 15
            font.weight: Font.Medium
            text: "Dash16 Package"
        }

        SectionChips {
            model: ["Live page", "Display", "Pages", "Hardware", "Buttons"]
            currentIndex: editing
            onChosen: function(index) {
                editing = index
                flick.contentY = 0
            }
        }

        // A Flickable rather than a ScrollView, so that scrolling glides
        Flickable {
            id: flick
            Layout.fillWidth: true
            Layout.fillHeight: true
            Layout.minimumHeight: 0
            contentWidth: width
            contentHeight: content.height + 10
            clip: true
            ScrollBar.vertical: ScrollBar {
                interactive: Qt.platform.os !== "ios" && Qt.platform.os !== "android"
            }

            ColumnLayout {
                id: content
                // Clear of the scroll bar
                width: flick.width - flick.ScrollBar.vertical.implicitWidth - 4
                spacing: 10

                Note {
                    text: "Notes: Requires matching Dash16 package on ESC! " +
                          "WiFi and Bluetooth may not be enabled concurrently!"
                }

                SectionTitle {
                    text: "Status"
                }

                Group {
                    SettingRow {
                        label: "Display"
                        control: Text {
                            id: statusText
                            text: "Waiting for display..."
                            elide: Text.ElideRight
                            color: colText
                            font.weight: Font.Medium
                        }
                    }

                    SettingRow {
                        label: "Controller"
                        control: Text {
                            id: escState
                            text: "unknown"
                            elide: Text.ElideRight
                            color: colText
                            font.weight: Font.Medium
                        }
                    }

                    SettingRow {
                        label: "Package version"
                        value: "{{VERSION}}"
                    }
                }

                SectionTitle {
                    visible: editing === 3
                    text: "Units"
                }

                Group {
                    visible: editing === 3
                    SettingRow {
                        label: "Speed"
                        value: speedMetric.checked ? "km/h" : "MPH"
                        chevron: true

                        RowLayout {
                            RadioButton {
                                id: speedMetric
                                ButtonGroup.group: speedGroup
                                text: "km/h"
                                checked: true
                                onClicked: if (!loading) setSetting("units-metric", 1)
                            }

                            RadioButton {
                                id: speedImperial
                                ButtonGroup.group: speedGroup
                                text: "MPH"
                                onClicked: if (!loading) setSetting("units-metric", 0)
                            }
                        }
                    }

                    SettingRow {
                        label: "Temperature"
                        value: tempMetric.checked ? "C" : "F"
                        chevron: true

                        RowLayout {
                            RadioButton {
                                id: tempMetric
                                ButtonGroup.group: tempGroup
                                text: "C"
                                checked: true
                                onClicked: if (!loading) setSetting("temps-metric", 1)
                            }

                            RadioButton {
                                id: tempImperial
                                ButtonGroup.group: tempGroup
                                text: "F"
                                onClicked: if (!loading) setSetting("temps-metric", 0)
                            }
                        }
                    }
                }

                SectionTitle {
                    visible: editing === 3
                    text: "Controller"
                }

                Group {
                    visible: editing === 3
                    SettingRow {
                        label: "dash_esc"
                        value: escMode.currentText
                        chevron: true

                        ComboBox {
                            id: escMode
                            Layout.fillWidth: true
                            background: InputBackground {}
                            model: ["Auto detect", "Assume present", "Assume absent"]
                            onActivated: if (!loading) setSetting("esc-mode", currentIndex)
                        }
                    }

                    SettingRow {
                        label: "CAN id (0 = auto)"
                        value: escId.value

                        SpinBox {
                            id: escId
                            Layout.fillWidth: true
                            background: InputBackground {}
                            from: 0
                            to: 253
                            editable: true
                            onValueModified: if (!loading) setSetting("esc-id", value)
                        }
                    }
                }

                Note {
                    visible: editing === 3
                    text: "Without dash_esc the display reads standard CAN " +
                          "status frames. Speed, duty, voltage, current and " +
                          "both temperatures still work, and a VESC BMS still " +
                          "gives charge and pack temperature.\n\n" +
                          "These do not: watt hours, amp hours, odometer, " +
                          "range, efficiency, fault names, IMU pitch, average " +
                          "and peak current, cruise control, turn signals, " +
                          "high beam and kickstand. Trip shows distance since " +
                          "the controller booted.\n\n" +
                          "Drive modes are sent as a temporary profile, so " +
                          "they are not stored and a power cycle clears them."
                }

                SectionTitle {
                    visible: editing === 3
                    text: "Backlight"
                }

                Group {
                    visible: editing === 3
                    SettingRow {
                        label: "Dim"
                        value: Math.round(blSlider.value * 100) + " %"

                        Slider {
                            id: blSlider
                            Layout.fillWidth: true
                            from: 0.1
                            to: 1.0
                            value: 1.0
                            // Preview goes straight out rather than through the
                            // queue, so dragging tracks. A dropped one does not
                            // matter, the release below stores the real value.
                            onMoved: {
                                if (!loading) {
                                    VescIf.commands().sendCustomAppData(
                                        "(bl-preview " + value.toFixed(2) + ")\0")
                                }
                            }
                            onPressedChanged: {
                                if (!pressed && !loading) {
                                    setSetting("bl-bright", value.toFixed(2))
                                }
                            }
                        }
                    }
                }

                SectionTitle {
                    visible: editing === 3
                    text: "Lever"
                }

                Note {
                    visible: editing === 3
                    text: "The lever is read here and sent to the controller as " +
                          "ADC2. Hold it released and press Set min, pull it fully " +
                          "and press Set max."
                }

                Group {
                    visible: editing === 3
                    SettingRow {
                        label: "Now"
                        control: RowLayout {
                            spacing: 10

                            Text {
                                text: leverVolts.toFixed(3) + " V"
                                color: colText
                                font.weight: Font.Medium
                            }

                            ProgressBar {
                                Layout.preferredWidth: 80
                                from: 0.0
                                to: 1.0
                                value: leverPos
                            }

                            Text {
                                Layout.preferredWidth: 44
                                horizontalAlignment: Text.AlignRight
                                text: Math.round(leverPos * 100) + " %"
                                color: colText
                                font.weight: Font.Medium
                            }
                        }
                    }

                    SettingRow {
                        label: "Min"
                        value: parseFloat(leverMin.realValue).toFixed(3) + " V"

                        RowLayout {
                            Layout.fillWidth: true

                            DoubleSpinBox {
                                id: leverMin
                                Layout.fillWidth: true
                                realFrom: 0.0
                                realTo: 1.5
                                realValue: 0.45
                                decimals: 3
                                suffix: " V"
                                onRealValueChanged: if (!loading) setSetting("lever-min", realValue.toFixed(3))
                            }

                            Button {
                                text: "Set min"
                                onClicked: {
                                    leverMin.realValue = leverVolts
                                    setSetting("lever-min", leverVolts.toFixed(3))
                                }
                            }
                        }
                    }

                    SettingRow {
                        label: "Max"
                        value: parseFloat(leverMax.realValue).toFixed(3) + " V"

                        RowLayout {
                            Layout.fillWidth: true

                            DoubleSpinBox {
                                id: leverMax
                                Layout.fillWidth: true
                                realFrom: 1.0
                                realTo: 3.3
                                realValue: 2.10
                                decimals: 3
                                suffix: " V"
                                onRealValueChanged: if (!loading) setSetting("lever-max", realValue.toFixed(3))
                            }

                            Button {
                                text: "Set max"
                                onClicked: {
                                    leverMax.realValue = leverVolts
                                    setSetting("lever-max", leverVolts.toFixed(3))
                                }
                            }
                        }
                    }
                }

                SectionTitle {
                    visible: editing === 1
                    text: "Display"
                }

                Note {
                    visible: editing === 1
                    text: "Unticked icons are not drawn at all."
                }

                Group {
                    visible: editing === 1
                    SettingRow {
                        label: "Show the logo at startup"
                        control: Switch {
                            id: splashBox
                            onClicked: if (!loading) setSetting("splash-en", checked ? 1 : 0)
                        }
                    }

                    SettingRow {
                        label: "Colour the battery bar by charge"
                        control: Switch {
                            id: battRampBox
                            onClicked: if (!loading) setSetting("batt-ramp", checked ? 1 : 0)
                        }
                    }

                    Repeater {
                        id: iconRepeater
                        model: iconNames

                        SettingRow {
                            property int bit: iconBits[index]
                            property alias checked: iconSwitch.checked
                            label: modelData
                            control: Switch {
                                id: iconSwitch
                                checked: true
                                onClicked: if (!loading) setIconBit(bit, checked)
                            }
                        }
                    }
                }

                SectionTitle {
                    visible: editing === 2
                    text: "Pages"
                }

                Note {
                    visible: editing === 2
                    text: "Which pages the page button cycles through."
                }

                Group {
                    visible: editing === 2
                    SettingRow {
                        label: "Drive modes"
                        value: driveModes.value

                        SpinBox {
                            id: driveModes
                            Layout.fillWidth: true
                            background: InputBackground {}
                            from: 1
                            to: 5
                            onValueModified: if (!loading) setSetting("drive-modes", value)
                        }
                    }

                    Repeater {
                        id: pageRepeater
                        model: pageNames

                        SettingRow {
                            property int bit: index
                            property alias checked: pageSwitch.checked
                            label: modelData
                            control: Switch {
                                id: pageSwitch
                                checked: true
                                onClicked: if (!loading) setPageBit(bit, checked)
                            }
                        }
                    }
                }

                SectionTitle {
                    visible: editing === 0
                    text: "Live Page"
                }

                Note {
                    visible: editing === 0
                    text: "Four readings, two by two, on the first page."
                }

                Group {
                    visible: editing === 0
                    Repeater {
                        id: slotRepeater
                        model: 4

                        SettingRow {
                            property int slotIndex: index
                            property alias source: srcBox.currentIndex
                            label: (slotIndex < 2 ? "Top " : "Bottom ") +
                                   (slotIndex % 2 === 0 ? "left" : "right")
                            value: srcBox.currentText
                            chevron: true

                            ComboBox {
                                id: srcBox
                                Layout.fillWidth: true
                                background: InputBackground {}
                                model: slotNames
                                onActivated: {
                                    if (!loading) {
                                        setSetting("slot-" + slotIndex, currentIndex)
                                    }
                                }
                            }
                        }
                    }
                }

                SectionTitle {
                    visible: editing === 4
                    text: "Buttons"
                }

                Repeater {
                    id: btnRepeater
                    model: 2

                    Group {
                        property int btnIndex: index
                        property alias shortIndex: shortBox.currentIndex
                        property alias longIndex: longBox.currentIndex
                        visible: editing === 4
                        SettingRow {
                            label: (btnIndex === 0 ? "Up button" : "Down button") + ", short"
                            value: shortBox.currentText
                            chevron: true

                            ComboBox {
                                id: shortBox
                                Layout.fillWidth: true
                                background: InputBackground {}
                                model: actionNames
                                onActivated: {
                                    if (!loading) {
                                        setSetting("btn" + btnIndex + "-short",
                                                   actionCodes[currentIndex])
                                    }
                                }
                            }
                        }

                        SettingRow {
                            label: (btnIndex === 0 ? "Up button" : "Down button") + ", long"
                            value: longBox.currentText
                            chevron: true

                            ComboBox {
                                id: longBox
                                Layout.fillWidth: true
                                background: InputBackground {}
                                model: actionNames
                                onActivated: {
                                    if (!loading) {
                                        setSetting("btn" + btnIndex + "-long",
                                                   actionCodes[currentIndex])
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        RowLayout {
            Layout.fillWidth: true
            Layout.rightMargin: flick.ScrollBar.vertical.implicitWidth + 4

            Button {
                Layout.fillWidth: true
                Layout.preferredWidth: 1
                text: "Reset All"
                onClicked: {
                    statusText.text = "Resetting..."
                    send("(settings-reset)")
                }
            }

            Button {
                Layout.fillWidth: true
                Layout.preferredWidth: 1
                text: "Read From Display"
                onClicked: {
                    statusText.text = "Reading..."
                    haveRead = false
                    readPoll.running = true
                }
            }
        }
    }

}
